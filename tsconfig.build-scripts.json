{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".tsbuild",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "isolatedModules": false,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/lib/**/*.ts",
    "src/types.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
